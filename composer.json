{
    "name": "consolidated-witchcraft/binding-engine-vocabulary-loader",
    "description": "JSON loader for Consolidated Witchcraft Binding Engine vocabularies",
    "type": "library",
    "license": "AGPL-3.0-or-later",

    "autoload": {
        "psr-4": {
            "ConsolidatedWitchcraft\\BindingEngine\\VocabularyLoader\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/consolidated-witchcraft/binding-engine-parser.git",
            "no-api": true
        },
        {
            "type": "vcs",
            "url": "https://github.com/consolidated-witchcraft/binding-engine-vocabulary.git",
            "no-api": true
        }
    ],
    "authors": [
        {
            "name": "Sam Baynham",
            "email": "sam.baynham@gmail.com"
        }
    ],
    "minimum-stability": "dev",
    "homepage": "https://github.com/consolidated-witchcraft/binding-engine-vocabulary-loader",
    "support": {
        "issues": "https://github.com/consolidated-witchcraft/binding-engine-vocabulary-loader/issues",
        "source": "https://github.com/consolidated-witchcraft/binding-engine-vocabulary-loader"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "scripts": {
        "hooks:install": [
            "git config core.hooksPath .githooks",
            "chmod +x .githooks/pre-commit"
        ],
        "php-cs:check": "vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.dist.php --dry-run --diff --verbose --sequential",
        "php-cs:fix": "vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.dist.php --verbose --sequential",
        "test": "pest",
        "stan": "php -d memory_limit=1G vendor/bin/phpstan analyse"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "dev-master",
        "pestphp/pest": "5.x-dev",
        "phpstan/phpstan": "2.2.x-dev",
        "symfony/var-dumper": "8.1.x-dev"
    },
    "require": {
        "php": "^8.4",
        "consolidated-witchcraft/binding-engine-vocabulary": ">=0.1.0 <1.0.0"
    }
}
